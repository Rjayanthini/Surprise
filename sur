    </main>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>


        /* =================================================
           1. YOUR PHOTOS
        ================================================== */


        /*
           Put your photos inside an "images" folder.

           Example:

           images/wedding.jpg
           images/photo2.jpg
           images/photo3.jpg
           images/photo4.jpg
           images/recent.jpg

           Then change the names below if necessary.
        */


        const memories = [

            {
                image: "images/wedding.jpg",
                caption: "And it all began..."
            },

            {
                image: "images/photo2.jpg",
                caption: "Two people. One journey."
            },

            {
                image: "images/photo3.jpg",
                caption: "And then, a family."
            },

            {
                image: "images/photo4.jpg",
                caption: "A lot has happened since then. 😂"
            },

            {
                image: "images/recent.jpg",
                caption: "25 years later..."
            }

        ];



        /* =================================================
           2. AVAILABLE DATES
        ================================================== */


        /*
           CHANGE THESE.

           Only give them dates which are actually possible
           for your dad.
        */


        const dates = [

            {
                day: "Saturday",
                date: "5 September",
                description:
                    "A relaxed weekend date"
            },

            {
                day: "Sunday",
                date: "6 September",
                description:
                    "A slow day together"
            },

            {
                day: "Saturday",
                date: "12 September",
                description:
                    "Another chance to escape"
            },

            {
                day: "Sunday",
                date: "13 September",
                description:
                    "A little anniversary adventure"
            }

        ];



        /* =================================================
           3. DESTINATIONS
        ================================================== */


        /*
           Replace these with REAL destinations.

           That's much better than generic choices.

           Example:

           {
               icon: "🌊",
               name: "Kanyakumari",
               description: "Sea, sunset & dinner"
           }
        */


        const destinations = [

            {
                icon: "🌊",
                name: "Beach Day",
                description:
                    "Sunset, sea & snacks"
            },

            {
                icon: "🌿",
                name: "Nature Escape",
                description:
                    "Fresh air & a peaceful day"
            },

            {
                icon: "🍽️",
                name: "Dinner Date",
                description:
                    "Dress up. Eat well. Enjoy."
            },

            {
                icon: "🚗",
                name: "Road Trip",
                description:
                    "Somewhere new, just because."
            },

            {
                icon: "🎁",
                name: "Surprise Me",
                description:
                    "You trust your daughter? Brave choice. 😂"
            }

        ];



        /* =================================================
           4. APPLICATION STATE
        ================================================== */


        let currentMemory = 0;

        let selectedDate = null;

        let selectedDestination = null;



        /* =================================================
           5. DOM ELEMENTS
        ================================================== */


        const memoryImage =
            document.getElementById(
                "memoryImage"
            );


        const memoryCaption =
            document.getElementById(
                "memoryCaption"
            );


        const memoryCounter =
            document.getElementById(
                "memoryCounter"
            );


        const dots =
            document.getElementById(
                "dots"
            );


        const dateGrid =
            document.getElementById(
                "dateGrid"
            );


        const destinationGrid =
            document.getElementById(
                "destinationGrid"
            );


        const dateContinue =
            document.getElementById(
                "dateContinue"
            );


        const destinationContinue =
            document.getElementById(
                "destinationContinue"
            );



        /* =================================================
           6. SCREEN NAVIGATION
        ================================================== */


        function goToScreen(screenId) {


            document
                .querySelectorAll(".screen")
                .forEach(screen => {

                    screen.classList.remove(
                        "active"
                    );

                });


            const target =
                document.getElementById(
                    screenId
                );


            target.classList.add(
                "active"
            );


            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });


            createFloatingHeart();

        }



        /* =================================================
           7. MEMORY CAROUSEL
        ================================================== */


        function initialiseCarousel() {


            dots.innerHTML = "";


            memories.forEach(
                (memory, index) => {


                    const dot =
                        document.createElement(
                            "span"
                        );


                    dot.className =
                        "dot";


                    dot.addEventListener(
                        "click",
                        () => {

                            showMemory(index);

                        }
                    );


                    dots.appendChild(dot);

                }
            );


            showMemory(0);

        }



        function showMemory(index) {


            if (
                index < 0
            ) {

                index =
                    memories.length - 1;

            }


            if (
                index >= memories.length
            ) {

                index = 0;

            }


            currentMemory = index;


            memoryImage.classList.add(
                "fade"
            );


            setTimeout(() => {


                memoryImage.src =
                    memories[index].image;


                memoryCaption.textContent =
                    memories[index].caption;


                memoryCounter.textContent =
                    `${index + 1} / ${memories.length}`;


                document
                    .querySelectorAll(
                        ".dot"
                    )
                    .forEach(
                        (dot, dotIndex) => {

                            dot.classList.toggle(
                                "active",
                                dotIndex === index
                            );

                        }
                    );


                memoryImage.onload =
                    () => {

                        memoryImage.classList.remove(
                            "fade"
                        );

                    };


            }, 250);

        }



        function nextMemory() {

            showMemory(
                currentMemory + 1
            );

        }



        function previousMemory() {

            showMemory(
                currentMemory - 1
            );

        }



        /* =================================================
           8. DATE CARDS
        ================================================== */


        function createDateCards() {


            dates.forEach(
                (item) => {


                    const card =
                        document.createElement(
                            "button"
                        );


                    card.className =
                        "selection-card";


                    card.innerHTML = `

                        <div class="card-top">

                            <div>

                                <div class="day">
                                    ${item.day}
                                </div>

                                <div class="date">
                                    ${item.date}
                                </div>

                                <div class="card-description">
                                    ${item.description}
                                </div>

                            </div>

                            <div class="check">
                                ✓
                            </div>

                        </div>

                    `;


                    card.addEventListener(
                        "click",
                        () => {


                            document
                                .querySelectorAll(
                                    "#dateGrid .selection-card"
                                )
                                .forEach(
                                    otherCard => {

                                        otherCard.classList.remove(
                                            "selected"
                                        );

                                    }
                                );


                            card.classList.add(
                                "selected"
                            );


                            selectedDate =
                                item;


                            dateContinue.disabled =
                                false;


                            dateContinue.textContent =
                                "Continue →";

                        }
                    );


                    dateGrid.appendChild(
                        card
                    );

                }
            );

        }



        /* =================================================
           9. DESTINATION CARDS
        ================================================== */


        function createDestinationCards() {


            destinations.forEach(
                (item) => {


                    const card =
                        document.createElement(
                            "button"
                        );


                    card.className =
                        "selection-card destination-card";


                    card.innerHTML = `

                        <div class="destination-icon">
                            ${item.icon}
                        </div>

                        <div class="destination-info">

                            <div class="destination-name">
                                ${item.name}
                            </div>

                            <div class="card-description">
                                ${item.description}
                            </div>

                        </div>

                        <div class="check">
                            ✓
                        </div>

                    `;


                    card.addEventListener(
                        "click",
                        () => {


                            document
                                .querySelectorAll(
                                    "#destinationGrid .selection-card"
                                )
                                .forEach(
                                    otherCard => {

                                        otherCard.classList.remove(
                                            "selected"
                                        );

                                    }
                                );


                            card.classList.add(
                                "selected"
                            );


                            selectedDestination =
                                item;


                            destinationContinue.disabled =
                                false;


                            destinationContinue.textContent =
                                "Reveal the plan →";

                        }
                    );


                    destinationGrid.appendChild(
                        card
                    );

                }
            );

        }



        /* =================================================
           10. FINAL SCREEN
        ================================================== */


        function showFinalScreen() {


            if (
                !selectedDate ||
                !selectedDestination
            ) {

                return;

            }


            document.getElementById(
                "finalDate"
            ).textContent =

                `${selectedDate.day}, ${selectedDate.date}`;


            document.getElementById(
                "finalDestination"
            ).textContent =

                `${selectedDestination.icon} ${selectedDestination.name}`;


            goToScreen(
                "screen-final"
            );


            setTimeout(
                launchConfetti,
                500
            );

        }



        /* =================================================
           11. CONFETTI
        ================================================== */


        function launchConfetti() {


            const numberOfPieces = 90;


            const colors = [

                "#873b47",

                "#b79a5a",

                "#e3d8ce",

                "#302824"

            ];


            for (
                let i = 0;
                i < numberOfPieces;
                i++
            ) {


                const piece =
                    document.createElement(
                        "div"
                    );


                piece.className =
                    "confetti";


                piece.style.background =
                    colors[
                        Math.floor(
                            Math.random() *
                            colors.length
                        )
                    ];


                piece.style.left =
                    Math.random() *
                    100 +
                    "vw";


                piece.style.animationDuration =
                    (
                        3 +
                        Math.random() * 4
                    ) +
                    "s";


                piece.style.animationDelay =
                    Math.random() *
                    0.8 +
                    "s";


                piece.style.transform =
                    `rotate(
                        ${Math.random() * 360}deg
                    )`;


                document.body.appendChild(
                    piece
                );


                setTimeout(
                    () => {

                        piece.remove();

                    },
                    8000
                );

            }

        }



        /* =================================================
           12. FLOATING HEART
        ================================================== */


        function createFloatingHeart() {


            const heart =
                document.createElement(
                    "div"
                );


            heart.className =
                "floating-heart";


            heart.textContent =
                "♡";


            heart.style.left =
                Math.random() *
                100 +
                "vw";


            heart.style.fontSize =
                (
                    15 +
                    Math.random() * 15
                ) +
                "px";


            heart.style.animationDuration =
                (
                    5 +
                    Math.random() * 4
                ) +
                "s";


            document.body.appendChild(
                heart
            );


            setTimeout(
                () => {

                    heart.remove();

                },
                9000
            );

        }



        /* =================================================
           13. BUTTON EVENTS
        ================================================== */


        document
            .getElementById("beginBtn")
            .addEventListener(
                "click",
                () => {

                    goToScreen(
                        "screen-memories"
                    );

                }
            );


        document
            .getElementById("planBtn")
            .addEventListener(
                "click",
                () => {

                    goToScreen(
                        "screen-date"
                    );

                }
            );


        document
            .getElementById("previousBtn")
            .addEventListener(
                "click",
                previousMemory
            );


        document
            .getElementById("nextBtn")
            .addEventListener(
                "click",
                nextMemory
            );


        dateContinue
            .addEventListener(
                "click",
                () => {

                    if (!selectedDate) {

                        return;

                    }


                    goToScreen(
                        "screen-destination"
                    );

                }
            );


        destinationContinue
            .addEventListener(
                "click",
                showFinalScreen
            );


        document
            .getElementById("backBtn")
            .addEventListener(
                "click",
                () => {

                    goToScreen(
                        "screen-memories"
                    );

                }
            );



        /* =================================================
           14. MOBILE SWIPE
        ================================================== */


        let touchStartX = 0;


        memoryImage.addEventListener(
            "touchstart",
            event => {

                touchStartX =
                    event.touches[0].clientX;

            },
            {
                passive: true
            }
        );


        memoryImage.addEventListener(
            "touchend",
            event => {


                const touchEndX =
                    event.changedTouches[0].clientX;


                const difference =
                    touchStartX -
                    touchEndX;


                if (
                    Math.abs(difference) < 50
                ) {

                    return;

                }


                if (
                    difference > 0
                ) {

                    nextMemory();

                } else {

                    previousMemory();

                }

            },
            {
                passive: true
            }
        );



        /* =================================================
           15. START
        ================================================== */


        initialiseCarousel();

        createDateCards();

        createDestinationCards();


    </script>

</body>

</html>

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="theme-color"
          content="#fbf7f2">

    <title>25 Years & Still Counting ❤️</title>


    <!-- =====================================================
         FONTS
    ====================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         CSS
    ====================================================== -->

    <style>

        /* =====================================================
           COLORS & VARIABLES
        ====================================================== */

        :root {

            --background: #fbf7f2;

            --cream: #f3ebe3;

            --burgundy: #873b47;

            --burgundy-dark: #682c36;

            --gold: #b79a5a;

            --brown: #302824;

            --muted: #756c66;

            --border: #e3d8ce;

            --white: #ffffff;

            --heading:
                "Cormorant Garamond",
                Georgia,
                serif;

            --body:
                "Inter",
                Arial,
                sans-serif;

        }


        /* =====================================================
           RESET
        ====================================================== */

        * {

            margin: 0;

            padding: 0;

            box-sizing: border-box;

        }


        html {

            scroll-behavior: smooth;

        }


        body {

            background: var(--background);

            color: var(--brown);

            font-family: var(--body);

            overflow-x: hidden;

        }


        button {

            font-family: inherit;

        }


        /* =====================================================
           SCREEN
        ====================================================== */

        .screen {

            min-height: 100vh;

            display: none;

            align-items: center;

            justify-content: center;

            padding:
                40px
                20px;

            position: relative;

            overflow: hidden;

        }


        .screen.active {

            display: flex;

            animation:
                screenAppear
                0.8s
                ease;

        }


        @keyframes screenAppear {

            from {

                opacity: 0;

                transform:
                    translateY(20px);

            }

            to {

                opacity: 1;

                transform:
                    translateY(0);

            }

        }


        .container {

            width: 100%;

            max-width: 620px;

            margin: auto;

            text-align: center;

        }


        /* =====================================================
           TYPOGRAPHY
        ====================================================== */

        .eyebrow {

            font-size: 10px;

            letter-spacing: 3px;

            text-transform: uppercase;

            color: var(--gold);

            margin-bottom: 18px;

        }


        h1,
        h2,
        h3 {

            font-family: var(--heading);

            font-weight: 500;

        }


        h1 {

            font-size:
                clamp(
                    58px,
                    15vw,
                    105px
                );

            line-height: 0.82;

        }


        h2 {

            font-size:
                clamp(
                    45px,
                    11vw,
                    68px
                );

            line-height: 0.9;

        }


        .italic {

            font-style: italic;

        }


        .subtitle {

            font-family: var(--heading);

            font-size: 27px;

            line-height: 1.25;

            margin-top: 30px;

        }


        .description {

            max-width: 480px;

            margin:
                20px
                auto
                0;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.8;

        }


        /* =====================================================
           HEART
        ====================================================== */

        .heart {

            color: var(--burgundy);

            font-size: 30px;

            margin: 22px 0;

            animation:
                heartbeat
                2s
                ease-in-out
                infinite;

        }


        @keyframes heartbeat {

            0%,
            100% {

                transform: scale(1);

            }

            50% {

                transform: scale(1.15);

            }

        }


        /* =====================================================
           BUTTONS
        ====================================================== */

        .primary-btn {

            margin-top: 32px;

            padding:
                15px
                28px;

            border: none;

            border-radius: 999px;

            background:
                var(--burgundy);

            color: white;

            font-size: 13px;

            cursor: pointer;

            transition:
                0.25s ease;

        }


        .primary-btn:hover {

            background:
                var(--burgundy-dark);

            transform:
                translateY(-2px);

            box-shadow:
                0 12px 30px
                rgba(
                    135,
                    59,
                    71,
                    0.18
                );

        }


        .primary-btn:disabled {

            opacity: 0.4;

            cursor: not-allowed;

            transform: none;

            box-shadow: none;

        }


        .secondary-btn {

            margin-top: 20px;

            padding:
                12px
                22px;

            background: transparent;

            border:
                1px solid
                var(--border);

            border-radius: 999px;

            color:
                var(--burgundy);

            cursor: pointer;

        }


        /* =====================================================
           WELCOME SCREEN
        ====================================================== */

        .welcome-inner {

            position: relative;

        }


        .welcome-inner::before {

            content: "";

            position: absolute;

            width: 340px;

            height: 340px;

            border:
                1px solid
                rgba(
                    183,
                    154,
                    90,
                    0.18
                );

            border-radius: 50%;

            left: 50%;

            top: 50%;

            transform:
                translate(
                    -50%,
                    -50%
                );

            pointer-events: none;

        }


        /* =====================================================
           MEMORY CAROUSEL
        ====================================================== */

        .memory-wrapper {

            max-width: 480px;

            margin:
                35px
                auto
                0;

        }


        .memory-image-container {

            width: 100%;

            overflow: hidden;

            border-radius: 20px;

            background:
                var(--cream);

            box-shadow:
                0 20px 50px
                rgba(
                    48,
                    40,
                    36,
                    0.12
                );

        }


        .memory-image {

            width: 100%;

            aspect-ratio: 4 / 5;

            display: block;

            object-fit: cover;

            transition:
                opacity 0.4s ease,
                transform 0.5s ease;

        }


        .memory-image.fade {

            opacity: 0;

            transform:
                scale(1.03);

        }


        .memory-caption {

            font-family: var(--heading);

            font-size: 28px;

            margin-top: 18px;

        }


        .memory-counter {

            color: var(--gold);

            font-size: 10px;

            letter-spacing: 2px;

            margin-top: 8px;

        }


        .carousel-controls {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 25px;

            margin-top: 20px;

        }


        .carousel-arrow {

            width: 42px;

            height: 42px;

            border-radius: 50%;

            border:
                1px solid
                var(--border);

            background: transparent;

            cursor: pointer;

            font-size: 23px;

            color: var(--brown);

        }


        .dots {

            display: flex;

            gap: 7px;

        }


        .dot {

            width: 6px;

            height: 6px;

            border-radius: 50%;

            background:
                var(--border);

            cursor: pointer;

            transition:
                0.25s ease;

        }


        .dot.active {

            background:
                var(--burgundy);

            transform:
                scale(1.4);

        }


        /* =====================================================
           SELECTION CARDS
        ====================================================== */

        .selection-grid {

            display: grid;

            grid-template-columns:
                1fr;

            gap: 12px;

            margin-top: 30px;

        }


        .selection-card {

            width: 100%;

            padding: 18px 20px;

            border:
                1px solid
                var(--border);

            border-radius: 17px;

            background:
                rgba(
                    255,
                    255,
                    255,
                    0.4
                );

            color: var(--brown);

            cursor: pointer;

            text-align: left;

            transition:
                0.25s ease;

        }


        .selection-card:hover {

            background:
                white;

            transform:
                translateY(-2px);

            border-color:
                var(--gold);

        }


        .selection-card.selected {

            background:
                var(--burgundy);

            color: white;

            border-color:
                var(--burgundy);

        }


        .card-top {

            display: flex;

            justify-content:
                space-between;

            align-items: center;

        }


        .day {

            font-size: 10px;

            letter-spacing: 2px;

            text-transform:
                uppercase;

            opacity: 0.65;

        }


        .date {

            font-family:
                var(--heading);

            font-size: 29px;

            margin-top: 3px;

        }


        .card-description {

            font-size: 11px;

            margin-top: 5px;

            opacity: 0.65;

        }


        .check {

            width: 23px;

            height: 23px;

            border:
                1px solid
                currentColor;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            opacity: 0.35;

        }


        .selected .check {

            opacity: 1;

        }


        /* =====================================================
           DESTINATION CARDS
        ====================================================== */

        .destination-card {

            display: flex;

            align-items: center;

            gap: 15px;

        }


        .destination-icon {

            width: 48px;

            height: 48px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                var(--cream);

            font-size: 22px;

            flex-shrink: 0;

        }


        .selected
        .destination-icon {

            background:
                rgba(
                    255,
                    255,
                    255,
                    0.15
                );

        }


        .destination-info {

            flex: 1;

        }


        .destination-name {

            font-family:
                var(--heading);

            font-size: 27px;

        }


        /* =====================================================
           FINAL SCREEN
        ====================================================== */

        .final-title {

            font-family:
                var(--heading);

            font-size:
                clamp(
                    65px,
                    15vw,
                    100px
                );

            line-height: 0.82;

        }


        .final-small {

            font-size: 10px;

            letter-spacing: 3px;

            text-transform:
                uppercase;

            color:
                var(--gold);

            margin-bottom: 20px;

        }


        .final-date {

            font-family:
                var(--heading);

            font-size: 38px;

            margin-top: 35px;

        }


        .final-destination {

            font-family:
                var(--heading);

            font-size: 32px;

            color:
                var(--burgundy);

            margin-top: 8px;

        }


        .divider {

            width: 60px;

            height: 1px;

            background:
                var(--gold);

            margin:
                30px
                auto;

        }


        .final-message {

            font-family:
                var(--heading);

            font-size: 28px;

            line-height: 1.35;

        }


        .signature {

            margin-top: 30px;

            font-size: 12px;

            line-height: 1.7;

        }


        /* =====================================================
           FLOATING HEARTS
        ====================================================== */

        .floating-heart {

            position: fixed;

            bottom: -20px;

            color:
                rgba(
                    135,
                    59,
                    71,
                    0.2
                );

            pointer-events: none;

            animation:
                floatUp
                6s
                linear
                forwards;

            z-index: 20;

        }


        @keyframes floatUp {

            from {

                transform:
                    translateY(0)
                    rotate(0deg);

                opacity: 0;

            }

            15% {

                opacity: 1;

            }

            to {

                transform:
                    translateY(-110vh)
                    rotate(30deg);

                opacity: 0;

            }

        }


        /* =====================================================
           CONFETTI
        ====================================================== */

        .confetti {

            position: fixed;

            top: -20px;

            width: 7px;

            height: 12px;

            z-index: 100;

            pointer-events: none;

            animation:
                confettiFall
                linear
                forwards;

        }


        @keyframes confettiFall {

            to {

                transform:
                    translateY(110vh)
                    rotate(720deg);

                opacity: 0;

            }

        }


        /* =====================================================
           DESKTOP
        ====================================================== */

        @media (min-width: 600px) {

            .selection-grid {

                grid-template-columns:
                    1fr 1fr;

            }

        }


        /* =====================================================
           MOBILE
        ====================================================== */

        @media (max-width: 480px) {

            .screen {

                padding:
                    30px 17px;

            }


            .subtitle {

                font-size: 24px;

            }


            .description {

                font-size: 13px;

            }


            .memory-image {

                aspect-ratio:
                    3 / 4;

            }

        }

    </style>

</head>


<body>


    <!-- =====================================================
         APPLICATION
    ====================================================== -->

    <main id="app">


        <!-- =================================================
             SCREEN 1 — WELCOME
        ================================================== -->

        <section
            id="screen-welcome"
